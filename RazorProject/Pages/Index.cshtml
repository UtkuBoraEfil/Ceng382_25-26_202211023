@page
@model IndexModel
@{
    ViewData["Title"] = "Index";
}

<div class="container mt-4">
    <div class="row">
        <!-- Filter Form -->
        <div class="col-md-4">
            <form method="get">
                <div class="mb-3">
                    <label for="filterClassName" class="form-label">Filter by Class Name</label>
                    <input type="text" id="filterClassName" name="filterClassName" class="form-control" value="@Model.FilterClassName" />
                </div>
                <button type="submit" class="btn btn-primary">Filter</button>
            </form>
        </div>
    </div>

    <!-- Table -->
    <div class="row mt-4">
        <div class="col-md-12">
            <table class="table table-bordered">
                <thead>
                    <tr>
                        <th>Id</th>
                        <th>Name</th>
                        <th>Person Count</th>
                        <th>Description</th>
                        <th>Is Active</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.ClassList)
                    {
                        <tr>
                            @if (Model.EditingId == item.Id)
                            {
                                <form method="post" asp-page-handler="Save">
                                    <td>
                                        <input type="hidden" name="id" value="@item.Id" />
                                        <input type="text" name="name" value="@item.Name" class="form-control form-control-sm" />
                                    </td>
                                    <td>
                                        <input type="number" name="personCount" value="@item.PersonCount" class="form-control form-control-sm" />
                                    </td>
                                    <td>
                                        <input type="text" name="description" value="@item.Description" class="form-control form-control-sm" />
                                    </td>
                                    <td>
                                        <input type="checkbox" name="isActive" @(item.IsActive ? "checked" : "") />
                                    </td>
                                    <td>
                                        <button type="submit" class="btn btn-success btn-sm">Save</button>
                                        <a href="/" class="btn btn-secondary btn-sm">Cancel</a>
                                    </td>
                                </form>
                            }
                            else
                            {
                                <td>@item.Id</td>
                                <td>@item.Name</td>
                                <td>@item.PersonCount</td>
                                <td>@item.Description</td>
                                <td>@(item.IsActive ? "Yes" : "No")</td>
                                <td>
                                    <form method="post" asp-page-handler="Edit" class="d-inline">
                                        <input type="hidden" name="id" value="@item.Id" />
                                        <button type="submit" class="btn btn-warning btn-sm">Edit</button>
                                    </form>
                                    <form method="post" asp-page-handler="Delete" class="d-inline">
                                        <input type="hidden" name="id" value="@item.Id" />
                                        <button type="submit" class="btn btn-danger btn-sm">Delete</button>
                                    </form>
                                </td>
                            }
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <!-- Pagination -->
    <div class="row">
        <div class="col-md-12">
            <nav>
                <ul class="pagination">
                    <li class="page-item @(Model.CurrentPage == 1 ? "disabled" : "")">
                        <a class="page-link" href="?filterClassName=@Model.FilterClassName&currentPage=@(Model.CurrentPage - 1)">Previous</a>
                    </li>
                    @for (int i = 1; i <= Model.TotalPages; i++)
                    {
                        <li class="page-item @(Model.CurrentPage == i ? "active" : "")">
                            <a class="page-link" href="?filterClassName=@Model.FilterClassName&currentPage=@i">@i</a>
                        </li>
                    }
                    <li class="page-item @(Model.CurrentPage == Model.TotalPages ? "disabled" : "")">
                        <a class="page-link" href="?filterClassName=@Model.FilterClassName&currentPage=@(Model.CurrentPage + 1)">Next</a>
                    </li>
                </ul>
            </nav>
        </div>
    </div>

    <!-- Export and Column Selection -->
    <div class="row mt-4">
        <div class="col-md-12">
            <form method="post">
                <div>
                    <label>Select Columns:</label>
                    <input type="checkbox" name="selectedColumns" value="Id" /> Id
                    <input type="checkbox" name="selectedColumns" value="Name" /> Name
                    <input type="checkbox" name="selectedColumns" value="PersonCount" /> Person Count
                    <input type="checkbox" name="selectedColumns" value="Description" /> Description
                </div>
                <button type="submit" asp-page-handler="ExportJson" asp-route-isFiltered="true">Export Filtered to JSON</button>
                <button type="submit" asp-page-handler="ExportJson" asp-route-isFiltered="false">Export All to JSON</button>
            </form>
        </div>
    </div>
</div>